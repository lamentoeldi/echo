# env examples for tg bot

# S3 access key id
S3_ACCESS_KEY_ID=moonfire

# S3 secret access key
S3_SECRET_ACCESS_KEY=moonfire

# S3 URL in protocol://domain format
S3_URL=http://s3:9000

# Postgres host
PG_HOST=postgres

# Postgres port
PG_PORT=5432

# Postgres user
PG_USER=postgres

# Postgres password
PG_PASSWORD=postgres

# Postgres database
PG_DB=postgres

# Kafka bootstrap servers in ["host:port","host:port"] format
KAFKA_BOOTSTRAP_SERVERS=["kafka:9092"]
KAFKA_CONSUMER_GROUP=tg_bot

# Default locale language
DEFAULT_LOCALE=en

# Telegram Bot API connection mode: long_polling | webhook
# long_polling on default
BOT_API_MODE=webhook

# Telegram Bot API token
BOT_TOKEN=7153357657:AFG613uy8BkBIskL8oGxQoDoJ-SC_Vs-Z3P

# Telegram Bot API webhook secret token. Must be set in webhook mode only
WEBHOOK_SECRET=webhook-super-secret

# docker compose env variables

# ngrok auth token
NGROK_AUTHTOKEN=your-auth-token

# ngrok base url
NGROK_BASE_URL=your-base-url.ngrok.com

# Telegram Bot API webhook url
WEBHOOK_URL=your-base-url.ngrok.com/webhook